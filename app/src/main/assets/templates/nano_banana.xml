    android:height="400dp"
    android:viewportWidth="400"
    android:viewportHeight="400">
    
    <!-- Background or Border -->
    <path
        android:id="bg"
        android:pathData="M 0,0 L 400,0 L 400,400 L 0,400 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1"/>

    <!-- Stem of the banana -->
    <path
