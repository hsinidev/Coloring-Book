        android:pathData="M 200,50 C 190,50 180,60 180,80 L 220,80 C 220,60 210,50 200,50 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="3"/>

    <!-- Banana body split into sections for coloring -->
    <!-- Section 1: Top Peel Left -->
    <path
        android:id="peel_top_left"
        android:pathData="M 180,80 C 120,130 90,200 90,260 C 90,300 110,330 140,350 C 120,310 110,240 180,180 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="3"/>

    <!-- Section 2: Top Peel Right -->
    <path
        android:id="peel_top_right"
        android:pathData="M 220,80 C 280,130 310,200 310,260 C 310,300 290,330 260,350 C 280,310 290,240 220,180 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="3"/>

    <!-- Section 3: Main Banana Body Upper -->
    <path
        android:id="body_upper"
        android:pathData="M 180,180 C 110,240 120,310 140,350 C 150,355 170,360 200,360 C 170,320 170,250 200,180 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="3"/>

    <!-- Section 4: Main Banana Body Lower -->
