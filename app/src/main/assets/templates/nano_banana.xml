        android:strokeWidth="2"/>

    <!-- Star 2 inside the body -->
    <path
        android:id="star_2"
        android:pathData="M 200,260 L 203,266 L 210,266 L 205,270 L 207,276 L 200,272 L 193,276 L 195,270 L 190,266 L 197,266 Z"
