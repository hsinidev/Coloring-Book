        android:pathData="M 140,350 C 150,370 250,370 260,350 L 200,380 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="3"/>
        
    <!-- Extra details for fun coloring -->
    <!-- Detail Stripe 1 -->
    <path
        android:id="stripe_1"
        android:pathData="M 190,100 C 180,120 160,150 150,180 C 160,160 180,130 190,100 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"/>

    <!-- Detail Stripe 2 -->
    <path
        android:id="stripe_2"
        android:pathData="M 210,100 C 220,120 240,150 250,180 C 240,160 220,130 210,100 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"/>

    <!-- Star 1 inside the body -->
    <path
        android:id="star_1"
        android:pathData="M 200,220 L 203,226 L 210,226 L 205,230 L 207,236 L 200,232 L 193,236 L 195,230 L 190,226 L 197,226 Z"
